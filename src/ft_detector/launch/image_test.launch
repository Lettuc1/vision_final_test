<launch>
    <param name="/use_sim_time" value="true" />

    <node pkg="ft_detector" type="image_receiver" name="image_receiver_node" output="screen" />
    
    <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view" args="/ft/debug/image" />

    <node pkg="rosbag" type="play" name="player" output="screen" args="--clock /root/rosbags/blue_1.bag" />

</launch>
